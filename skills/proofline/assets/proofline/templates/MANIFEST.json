{
  "schema_version": "ciph.manifest.v1",
  "task_id": "<run-id>",
  "objective": "<original objective>",
  "trace": {
    "schema_version": "ciph.trace.v1",
    "path": "runs/<run-id>/TRACE.jsonl",
    "strict": true
  },
  "policy_modules": [
    "harness/policies/state.md",
    "harness/policies/context.md",
    "harness/policies/verification.md",
    "harness/policies/recovery.md",
    "harness/policies/delegation.md",
    "harness/policies/candidate-search.md",
    "harness/policies/stopping.md"
  ],
  "deliverables": [
    {
      "id": "example",
      "requirement": "Replace this with a concrete requirement from the prompt.",
      "artifact_paths": [
        "path/to/artifact.html"
      ],
      "evidence_paths": [
        "runs/<run-id>/artifacts/verification.html"
      ]
    }
  ],
  "artifacts": [
    {
      "path": "path/to/artifact.html",
      "description": "Replace this with the artifact purpose.",
      "required": true
    }
  ],
  "checks": [
    {
      "name": "replace-with-check-name",
      "command": "replace with exact command",
      "required": true,
      "evidence": "runs/<run-id>/artifacts/checks/replace-with-check-name.txt",
      "evidence_producer": "run_checks"
    }
  ],
  "risks": []
}
