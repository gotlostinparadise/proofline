{
  "schema_version": "ciph.evaluator-manifest.v1",
  "evaluator_id": "search-evaluator",
  "evaluation_phase": "search",
  "command": "python3 tools/evaluate.py --phase search --run runs/ciph-v0.18-score-provenance",
  "input_paths": [
    "runs/ciph-v0.18-score-provenance/artifacts/search-input.json"
  ],
  "output_paths": [
    "runs/ciph-v0.18-score-provenance/candidates/baseline/score.json",
    "runs/ciph-v0.18-score-provenance/candidates/frontier/score.json"
  ],
  "evidence_paths": [
    "runs/ciph-v0.18-score-provenance/artifacts/search-evidence.txt"
  ],
  "metric_keys": [
    "task_success",
    "audit_completeness",
    "cost_tokens",
    "wall_minutes",
    "defect_escape_rate"
  ]
}
