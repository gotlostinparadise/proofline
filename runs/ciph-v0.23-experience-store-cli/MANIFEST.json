{
  "schema_version": "ciph.manifest.v1",
  "task_id": "ciph-v0.23-experience-store-cli",
  "objective": "Implement CIPH v0.23 Queryable Experience Store CLI: add a deterministic read-only command that indexes prior run traces, manifests, deliverables, checks, closeout status, and replay receipt evidence into queryable JSON/HTML reports with docs, Proofline bundle sync, and dogfood evidence.",
  "trace": {
    "schema_version": "ciph.trace.v1",
    "path": "runs/ciph-v0.23-experience-store-cli/TRACE.jsonl"
  },
  "policy_modules": [
    "harness/policies/state.md",
    "harness/policies/context.md",
    "harness/policies/verification.md",
    "harness/policies/recovery.md",
    "harness/policies/delegation.md",
    "harness/policies/candidate-search.md",
    "harness/policies/stopping.md"
  ],
  "deliverables": [
    {
      "id": "experience-store-cli",
      "requirement": "Provide a deterministic read-only CLI that indexes run manifests, traces, checks, closeout events, and replay receipts into filterable experience records.",
      "artifact_paths": [
        "scripts/query_experience_store.py",
        "tests/test_query_experience_store.py",
        "runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.json",
        "runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.html"
      ],
      "evidence_paths": [
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-tests.txt",
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-json.txt",
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-html.txt"
      ]
    },
    {
      "id": "proofline-skill-sync",
      "requirement": "Mirror the experience-store CLI and usage guidance into bundled and installed Proofline assets.",
      "artifact_paths": [
        "skills/proofline/SKILL.md",
        "skills/proofline/assets/proofline/scripts/query_experience_store.py",
        "skills/proofline/assets/proofline/harness/CIPH.md",
        "tests/test_proofline_skill.py"
      ],
      "evidence_paths": [
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/proofline-skill-tests.txt",
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/installed-proofline-query.txt"
      ]
    },
    {
      "id": "docs-and-closeout",
      "requirement": "Document the queryable experience store and close out the dogfood run with generated status, metrics, and closeout evidence.",
      "artifact_paths": [
        "README.md",
        "harness/CIPH.md",
        "docs/plans/2026-05-21-ciph-v0.23-experience-store-cli-design.md",
        "docs/plans/2026-05-21-ciph-v0.23-experience-store-cli.md",
        "runs/ciph-v0.23-experience-store-cli/TASK.html",
        "runs/ciph-v0.23-experience-store-cli/MANIFEST.json",
        "runs/ciph-v0.23-experience-store-cli/TRACE.jsonl",
        "runs/ciph-v0.23-experience-store-cli/artifacts/status.html",
        "runs/ciph-v0.23-experience-store-cli/artifacts/closeout.html",
        "runs/ciph-v0.23-experience-store-cli/artifacts/mechanism-metrics.html"
      ],
      "evidence_paths": [
        "runs/ciph-v0.23-experience-store-cli/artifacts/checks/full-unit-tests.txt"
      ]
    }
  ],
  "artifacts": [
    {
      "path": "runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.json",
      "description": "Dogfood JSON experience store query output.",
      "required": true
    },
    {
      "path": "runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.html",
      "description": "Dogfood HTML experience store query output.",
      "required": true
    },
    {
      "path": "scripts/query_experience_store.py",
      "description": "Read-only experience store query CLI.",
      "required": true
    }
  ],
  "checks": [
    {
      "name": "experience-store-tests",
      "command": "python3 -m unittest tests.test_query_experience_store",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-tests.txt",
      "evidence_producer": "run_checks"
    },
    {
      "name": "experience-store-json",
      "command": "python3 scripts/query_experience_store.py --root . --runs-dir runs --status PASS --limit 8 --format json --output runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.json",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-json.txt",
      "evidence_producer": "run_checks"
    },
    {
      "name": "experience-store-html",
      "command": "python3 scripts/query_experience_store.py --root . --runs-dir runs --has-replay-receipts --format html --output runs/ciph-v0.23-experience-store-cli/artifacts/experience-store.html",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/experience-store-html.txt",
      "evidence_producer": "run_checks"
    },
    {
      "name": "proofline-skill-tests",
      "command": "python3 -m unittest tests.test_proofline_skill",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/proofline-skill-tests.txt",
      "evidence_producer": "run_checks"
    },
    {
      "name": "trace-ledger-lint",
      "command": "python3 scripts/lint_trace.py runs/ciph-v0.23-experience-store-cli/TRACE.jsonl --root .",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/trace-ledger-lint.txt",
      "evidence_producer": "run_checks"
    },
    {
      "name": "full-unit-tests",
      "command": "python3 -m unittest discover",
      "required": true,
      "evidence": "runs/ciph-v0.23-experience-store-cli/artifacts/checks/full-unit-tests.txt",
      "evidence_producer": "run_checks"
    }
  ],
  "risks": [
    "The query surface must remain read-only and must not mutate run records.",
    "Experience records must stay deterministic so repeated queries produce stable output apart from intentionally regenerated report files.",
    "The CLI must not print or serialize environment values, stdout/stderr bodies, or other secret-bearing data from evidence files.",
    "Bundled and installed Proofline assets must stay synchronized."
  ]
}
